{
  "$defs": {
    "ChartArtifact": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "const": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "data_base64": {
          "maxLength": 2000000,
          "minLength": 16,
          "title": "Data Base64",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "media_type",
        "sha256",
        "data_base64"
      ],
      "title": "ChartArtifact",
      "type": "object"
    },
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "label"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartPoint": {
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "timestamp",
        "value"
      ],
      "title": "ChartPoint",
      "type": "object"
    },
    "ChartSeries": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 3600,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "name",
        "unit",
        "points"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartSubmission": {
      "additionalProperties": false,
      "properties": {
        "chart_type": {
          "const": "line",
          "title": "Chart Type",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "x_axis": {
          "$ref": "#/$defs/ChartAxis"
        },
        "y_axis": {
          "$ref": "#/$defs/ChartAxis"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "artifact": {
          "$ref": "#/$defs/ChartArtifact"
        }
      },
      "required": [
        "chart_type",
        "title",
        "x_axis",
        "y_axis",
        "series",
        "artifact"
      ],
      "title": "ChartSubmission",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "modality": {
          "enum": [
            "metrics",
            "logs",
            "traces"
          ],
          "title": "Modality",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "record": {
          "additionalProperties": true,
          "title": "Record",
          "type": "object"
        }
      },
      "required": [
        "modality",
        "record_sha256",
        "record"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FinalAnomaly": {
      "additionalProperties": false,
      "properties": {
        "anomaly_type": {
          "title": "Anomaly Type",
          "type": "string"
        },
        "anomaly_description": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Anomaly Description",
          "type": "string"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "anomaly_type",
        "anomaly_description",
        "entity_type",
        "entity_id",
        "start_time",
        "end_time"
      ],
      "title": "FinalAnomaly",
      "type": "object"
    },
    "FinalAnswer": {
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "const": "FINAL_ANOMALY_INVESTIGATION",
          "title": "Task Type",
          "type": "string"
        },
        "schema_version": {
          "const": "final-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "pattern": "^(FT-0[1-3]|PK-R0[1-9])$",
          "title": "Task Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^SF-\\d{3}$",
          "title": "Case Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "agent_status": {
          "enum": [
            "COMPLETED",
            "PARTIAL",
            "FAILED",
            "ABSTAINED"
          ],
          "title": "Agent Status",
          "type": "string"
        },
        "anomalies": {
          "items": {
            "$ref": "#/$defs/FinalAnomaly"
          },
          "maxItems": 32,
          "title": "Anomalies",
          "type": "array"
        },
        "charts": {
          "items": {
            "$ref": "#/$defs/ChartSubmission"
          },
          "maxItems": 8,
          "title": "Charts",
          "type": "array"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "root_hypothesis": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalRootHypothesis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_reported_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Reported Usage"
        }
      },
      "required": [
        "task_type",
        "schema_version",
        "task_id",
        "case_id",
        "run_id",
        "agent_status",
        "summary"
      ],
      "title": "FinalAnswer",
      "type": "object"
    },
    "FinalRootHypothesis": {
      "additionalProperties": false,
      "properties": {
        "root_entity": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Root Entity",
          "type": "string"
        },
        "root_cause_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Root Cause Type",
          "type": "string"
        },
        "propagation_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Propagation Path",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "root_entity",
        "root_cause_type"
      ],
      "title": "FinalRootHypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "answer_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Answer Sha256",
      "type": "string"
    },
    "answer": {
      "$ref": "#/$defs/FinalAnswer"
    }
  },
  "required": [
    "idempotency_key",
    "answer_sha256",
    "answer"
  ],
  "title": "FinalSubmission",
  "type": "object"
}
