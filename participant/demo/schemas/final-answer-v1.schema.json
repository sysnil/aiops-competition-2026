{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiops-contest:final-answer:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_type", "schema_version", "task_id", "case_id", "run_id", "agent_status", "summary"],
  "properties": {
    "task_type": {"const": "FINAL_ANOMALY_INVESTIGATION"},
    "schema_version": {"const": "final-1.0"},
    "task_id": {"type": "string", "pattern": "^(FT-0[1-3]|PK-R0[1-9])$"},
    "case_id": {"type": "string", "pattern": "^SF-[0-9]{3}$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "agent_status": {"enum": ["COMPLETED", "PARTIAL", "FAILED", "ABSTAINED"]},
    "anomalies": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["anomaly_type", "anomaly_description", "entity_type", "entity_id", "start_time", "end_time"],
        "properties": {
          "anomaly_type": {"type": "string"},
          "anomaly_description": {"type": "string", "minLength": 8, "maxLength": 1000},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "start_time": {"type": "string", "format": "date-time"},
          "end_time": {"type": "string", "format": "date-time"},
          "evidence": {
            "type": "array", "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["modality", "record_sha256", "record"],
              "properties": {
                "modality": {"enum": ["metrics", "logs", "traces"]},
                "request_id": {"type": ["string", "null"], "maxLength": 128},
                "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "record": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "charts": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chart_type", "title", "x_axis", "y_axis", "series", "artifact"],
        "properties": {
          "chart_type": {"const": "line"},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "x_axis": {"$ref": "#/$defs/axis"},
          "y_axis": {"$ref": "#/$defs/axis"},
          "series": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "unit", "points"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 256},
                "unit": {"type": "string", "minLength": 1, "maxLength": 32},
                "points": {
                  "type": "array", "minItems": 1, "maxItems": 3600,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["timestamp", "value"],
                    "properties": {
                      "timestamp": {"type": "string", "format": "date-time"},
                      "value": {"type": ["number", "null"]}
                    }
                  }
                }
              }
            }
          },
          "artifact": {
            "type": "object", "additionalProperties": false,
            "required": ["filename", "media_type", "sha256", "data_base64"],
            "properties": {
              "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
              "media_type": {"const": "image/png"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "data_base64": {"type": "string", "minLength": 16, "maxLength": 2000000}
            }
          }
        }
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "root_hypothesis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["root_entity", "root_cause_type"],
      "properties": {
        "root_entity": {"type": "string", "minLength": 1, "maxLength": 256},
        "root_cause_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "propagation_path": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "supporting_evidence": {"type": "array", "maxItems": 32, "items": {"type": "string"}}
      }
    },
    "provider_reported_usage": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "integer"}
    }
  },
  "$defs": {
    "axis": {
      "type": "object", "additionalProperties": false, "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "unit": {"type": ["string", "null"], "maxLength": 32},
        "timezone": {"type": ["string", "null"], "maxLength": 32}
      }
    }
  }
}
