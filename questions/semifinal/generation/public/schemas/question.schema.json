{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semifinal query visualization Public question",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "case_id", "title", "description", "target_entity_type", "target_entity_id", "modality", "time_range", "query_spec", "chart_requirement", "questions", "question_version", "difficulty"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^(Q[0-9]{2}|EX-P[0-9]{2})$"},
    "case_id": {"type": "string", "pattern": "^SF-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "target_entity_type": {"enum": ["Service", "Pod", "CallEdge"]},
    "target_entity_id": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 2, "items": {"type": "string"}}]},
    "modality": {"enum": ["Metrics", "Logs", "Traces"]},
    "time_range": {
      "type": "object", "additionalProperties": false,
      "required": ["start_utc", "end_exclusive_utc"],
      "properties": {"start_utc": {"type": "string", "format": "date-time"}, "end_exclusive_utc": {"type": "string", "format": "date-time"}}
    },
    "query_spec": {
      "type": "object",
      "required": ["kind", "answer_plan", "source_file", "source_columns", "filters", "aggregation", "time_bucket", "minimum_samples_per_minute", "missing_policy", "counter_reset_policy", "p95_definition", "comparison_minute_ranges"],
      "properties": {
        "kind": {"enum": ["memory", "cpu_rate", "server_span_count", "error_log_count", "edge_error_count", "server_p95", "edge_p95"]},
        "answer_plan": {"enum": ["basic_mean", "basic_total", "compare", "window_count", "window_mean"]},
        "source_file": {"enum": ["metrics.parquet", "logs.parquet", "traces.parquet"]},
        "source_columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "filters": {"type": "object"},
        "aggregation": {"type": "string"},
        "time_bucket": {
          "type": "object", "additionalProperties": false,
          "required": ["origin_utc", "width_seconds", "closed", "timestamp_label", "observation_end_exclusive_utc"],
          "properties": {
            "origin_utc": {"type": "string", "format": "date-time"},
            "width_seconds": {"const": 60}, "closed": {"const": "left"},
            "timestamp_label": {"type": "string"},
            "observation_end_exclusive_utc": {"type": "string", "format": "date-time"}
          }
        },
        "minimum_samples_per_minute": {"type": "integer", "minimum": 0},
        "missing_policy": {"type": "string"},
        "counter_reset_policy": {"type": "string"},
        "p95_definition": {"type": "string"},
        "comparison_minute_ranges": {"type": ["array", "null"]}
      }
    },
    "chart_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["chart_count", "type", "x_axis", "y_axis", "series", "granularity_seconds", "legend_required"],
      "properties": {
        "chart_count": {"const": 1}, "type": {"const": "line"},
        "x_axis": {"type": "string"}, "y_axis": {"type": "string"},
        "series": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "granularity_seconds": {"const": 60}, "legend_required": {"type": "boolean"}
      }
    },
    "questions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "answer_format"],
        "properties": {"id": {"pattern": "^A[1-3]$", "type": "string"}, "text": {"type": "string", "minLength": 1}, "answer_format": {"enum": ["number", "time", "entity"]}}
      }
    },
    "question_version": {"type": "string"},
    "difficulty": {"enum": ["BASIC", "MEDIUM", "INTEGRATED", "EXAMPLE"]}
  }
}
