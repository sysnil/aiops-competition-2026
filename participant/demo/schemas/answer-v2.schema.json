{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiops-contest:answer:2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "schema_version", "anomalies"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "schema_version": {"const": "2.0"},
    "anomalies": {"type": "array", "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_type", "entity_id", "suspected_fault_type", "start_time", "end_time", "evidence"],
      "properties": {
        "entity_type": {"enum": ["Service", "Pod", "Node", "Network", "MetricSeries", "Unknown"]},
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\]*$"},
        "suspected_fault_type": {"enum": ["ServicePause", "ServiceCrash", "PodCPUThrottle", "PodMemoryPressure", "PodRestart", "NodeCPUContention", "NodeMemoryPressure", "NetworkDelay", "NetworkPacketLoss", "NetworkBandwidthLimit", "DNSError", "DatabaseLatency", "DependencyFailure", "ConfigurationError", "UNKNOWN"]},
        "start_time": {"type": "string", "format": "date-time", "maxLength": 40},
        "end_time": {"type": "string", "format": "date-time", "maxLength": 40},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["modality", "record_sha256", "record"],
          "properties": {
            "modality": {"enum": ["metrics", "logs", "traces"]},
            "request_id": {"type": ["string", "null"], "maxLength": 128},
            "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "record": {"type": "object", "minProperties": 1, "maxProperties": 24}
          }
        }}
      }
    }}
  }
}
